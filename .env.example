# Copy this file to .env and fill it in. Never share or commit .env.

# Claude API key (platform.claude.com → API Keys). Starts with sk-ant-
ANTHROPIC_API_KEY=

# Optional: monthly summary on Telegram (python cli.py summary --send)
# 1. Message @BotFather on Telegram → /newbot → copy the token
# 2. Message your new bot once, then open https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
